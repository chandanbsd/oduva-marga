# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Postgres (shared instance, two databases) ---
POSTGRES_USER=oduva
POSTGRES_PASSWORD=changeme
# Database used by Keycloak
POSTGRES_DB=keycloak
# Database used by oduva-marga-service, created on first boot by postgres/init-multiple-dbs.sh
SERVICE_DB_NAME=oduva_marga_service

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Realm you create by hand in the admin console (see Infrastructure/README.md)
KEYCLOAK_REALM=oduva-marga

# --- Public entrypoint ---
# The VM's public IP or domain name, and the single host port nginx publishes.
# Used to build the externally-visible Keycloak issuer URL and to publish the
# front-end container's port.
PUBLIC_HOST=203.0.113.10
PUBLIC_PORT=8080
